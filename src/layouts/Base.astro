---
/**
 * Base layout — every page inherits this.
 * Header, footer, skip link, and the SEO head.
 */
import Seo from '../components/Seo.astro';
import site from '../data/site.json';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Full-bleed pages (the work grid) skip the prose container. */
  wide?: boolean;
  /** Let a full-bleed hero run underneath the header instead of below it. */
  transparentHeader?: boolean;
}

const { title, description, ogImage, wide = false, transparentHeader = false } = Astro.props;
const path = Astro.url.pathname;

const isCurrent = (href: string) => {
  if (href === '/') return path === '/' || path === '/index.html';
  return path === href || path === `${href}.html` || path.startsWith(`${href}/`);
};
---

<!doctype html>
<html lang="en">
  <head>
    <Seo title={title} description={description} ogImage={ogImage} />

    {/*
      Arm the reveal animations before first paint. This must be inline and in
      <head>, not a module script: a deferred script would run after paint, so
      elements would render visible and then jump to hidden — a flash of content.

      Reveal elements default to visible in CSS and only hide once this class is
      present, so if JS is disabled or this fails, the page is fully readable.
    */}
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-reveal');
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class:list={['site-header', { 'site-header--over': transparentHeader }]}>
      <div class="wrap header-inner">
        <a href="/" class="wordmark" aria-label={`${site.name} — home`}>
          {site.name}
        </a>

        <nav aria-label="Primary">
          <ul class="nav-list">
            {site.nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="nav-link"
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class={wide ? '' : 'main-prose'}>
      <slot />
    </main>

  </body>
</html>

<script>
  /*
   * On the homepage the header floats transparently over the hero. Give it its
   * background back once the hero is out of view, otherwise the nav sits on the
   * work thumbnails and is illegible over bright frames.
   *
   * An IntersectionObserver on a 1px sentinel at the bottom of the hero, rather
   * than a scroll listener — no work on every frame, and it stays correct if the
   * hero's height changes.
   */
  const header = document.querySelector('.site-header--over');
  const hero = document.querySelector('.hero');

  if (header && hero) {
    const observer = new IntersectionObserver(
      ([entry]) => header.classList.toggle('is-scrolled', !entry.isIntersecting),
      { rootMargin: '-70px 0px 0px 0px', threshold: 0 }
    );
    observer.observe(hero);
  }

  /*
   * Scroll reveals. One observer for every [data-reveal] element, unobserving
   * each after it fires — these are one-shot entrances, not something that should
   * re-trigger and re-animate every time you scroll back up.
   *
   * rootMargin pulls the trigger line up from the bottom edge so elements are
   * already settled by the time they're properly in view, rather than animating
   * under the reader's eye.
   */
  const revealTargets = document.querySelectorAll<HTMLElement>('[data-reveal]');

  if (revealTargets.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const revealObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          (entry.target as HTMLElement).dataset.revealed = '';
          revealObserver.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.08 }
    );

    revealTargets.forEach((el) => revealObserver.observe(el));
  } else {
    // Reduced motion, or no targets: make sure nothing stays hidden.
    revealTargets.forEach((el) => { el.dataset.revealed = ''; });
  }
</script>

<style>
  /* ---------- Header ---------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--c-bg) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--c-line);
  }

  /*
   * Homepage only: sit over the hero rather than above it, so the media reaches
   * the top of the viewport. `position: fixed` rather than sticky, because a
   * sticky header still occupies layout space and would push the hero down.
   */
  .site-header--over {
    position: fixed;
    inset-inline: 0;
    background: transparent;
    backdrop-filter: none;
    border-bottom-color: transparent;
    transition: background var(--dur-base) var(--ease),
                border-color var(--dur-base) var(--ease);
  }

  /*
   * Once the hero has scrolled away, the header must take its background back.
   * Left transparent, the nav sits directly on the work thumbnails and becomes
   * unreadable over any bright frame. Toggled by the script below.
   */
  .site-header--over.is-scrolled {
    background: color-mix(in srgb, var(--c-bg) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom-color: var(--c-line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 4rem;
    flex-wrap: wrap;
  }

  .wordmark {
    font-size: var(--t-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    font-weight: 500;
    white-space: nowrap;
  }

  .nav-list {
    display: flex;
    gap: clamp(var(--s-4), 3vw, var(--s-6));
    list-style: none;
    padding: 0;
  }

  .nav-link {
    font-size: var(--t-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--c-text-muted);
    transition: color var(--dur-fast) var(--ease);
    padding-block: var(--s-2);
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--c-text);
  }

  /* ---------- Main ---------- */
  main { flex: 1 0 auto; }

  .main-prose {
    padding-block: var(--s-8) var(--s-9);
  }







  /* The header is sticky, so on a phone every pixel it occupies is a pixel of
     work the visitor can't see. Tighten it where it wraps to two rows. */
  @media (max-width: 34rem) {
    .header-inner {
      min-height: 0;
      padding-block: var(--s-3);
      gap: var(--s-2);
    }

    .nav-list { gap: var(--s-4); }
    .nav-link { padding-block: 0; }
  }
</style>
