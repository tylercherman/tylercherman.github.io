---
/**
 * About page.
 *
 * Everything a person would want to change lives in src/copy/about.md — the
 * headline, the body prose, and the search-engine description. Nothing on this page
 * needs editing to change the words.
 *
 * The About page is the main indexable text surface on an otherwise silent video
 * site, which is why the description is kept alongside the copy rather than being
 * hardcoded here where it drifts out of sync (it did).
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/tyler-cherman-portrait.jpg';
import site from '../data/site.json';
import copy from '../data/copy.json';
import { Content as AboutBody, frontmatter } from '../copy/about.md';

/** Falls back to the sitewide description if the markdown omits one. */
const description = frontmatter.description ?? site.description;
---

<Base title="About" description={description} wide>
  <div class="about wrap">
    <div class="about-grid">
      <div class="about-copy" data-reveal>
        <h1 class="lede">{frontmatter.headline}</h1>

        <div class="prose">
          <AboutBody />
        </div>

        <p class="about-links">
          <a href="/resume">{copy.links.resume}</a>
          <span aria-hidden="true">·</span>
          <a href="/contact">{copy.links.getInTouch}</a>
        </p>
      </div>

      <figure class="about-figure" data-reveal style="--reveal-delay: 120ms;">
        <Image
          src={portrait}
          alt={`${site.name}, editor, seated on a vintage CRT monitor showing the same shot with burned-in timecode.`}
          widths={[420, 700, 1100, 1796]}
          sizes="(max-width: 60rem) 100vw, 40vw"
          loading="eager"
          fetchpriority="high"
          class="about-photo"
        />
      </figure>
    </div>
  </div>
</Base>

<style>
  .about { padding-block: var(--s-7) var(--s-9); }

  .about-grid {
    display: grid;
    gap: var(--s-7);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.72fr);
      gap: var(--s-9);
    }
  }

  .about-copy {
    max-width: 40rem;
  }

  .lede {
    font-size: var(--t-2xl);
    font-weight: 400;
    letter-spacing: -0.015em;
    margin-bottom: var(--s-6);
    text-wrap: balance;
  }

  /*
   * :global because these <p> elements are produced by the markdown file rather
   * than written in this template, so Astro's scoped-style compiler can't tag them.
   */
  .prose :global(p) {
    font-size: var(--t-lg);
    color: var(--c-text-muted);
    margin-bottom: var(--s-5);
    max-width: 38rem;
  }

  .prose :global(p:last-child) { margin-bottom: 0; }

  /*
   * The closing line is bolded in the markdown (**like this**). Styling <strong>
   * here means the writer never has to know about CSS classes — bold the last line
   * and it lands as a statement.
   */
  .prose :global(strong) {
    color: var(--c-text);
    font-weight: 400;
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: baseline;
    margin-top: var(--s-6);
    font-size: var(--t-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--c-text-faint);
  }

  .about-links a {
    color: var(--c-text-muted);
    border-bottom: 1px solid var(--c-line-strong);
    padding-bottom: 1px;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .about-links a:hover {
    color: var(--c-text);
    border-color: var(--c-text);
  }

  .about-figure { margin: 0; }

  .about-photo {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  @media (min-width: 60rem) {
    /* Nudge the portrait down so it optically aligns with the body copy rather
       than the headline. */
    .about-figure { margin-top: var(--s-2); }
  }
</style>
