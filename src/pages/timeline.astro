---
/**
 * EXPERIMENT — the editing-suite layout.
 *
 * An alternative to the vertical grid on `/`, borrowing the shape of an NLE:
 * a viewer occupying the top of the screen, and a horizontal timeline of clips
 * below it that travels left-to-right. Clicking a clip loads it into the viewer.
 *
 * The vertical-grid version is untouched at `/` and tagged `v1-vertical-grid`.
 *
 * Deliberate details that make the metaphor read as intentional rather than as
 * decoration:
 *
 *  - Clip widths are proportional to runtime, exactly as they would be on a real
 *    timeline. That's what the `duration` field is for; it was kept in the schema
 *    when the runtime label was removed from the grid.
 *  - Heights are uniform, so a longer clip is a wider box showing the same frame.
 *  - The viewer letterboxes each piece at its true aspect ratio inside a fixed
 *    frame, which is what a program monitor does. Verticals get pillarboxed rather
 *    than cropped.
 *  - A vertical wheel gesture moves the timeline horizontally. The page is exactly
 *    one viewport tall with nothing to scroll to, so this is the only sensible
 *    reading of the gesture rather than hijacking.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

/**
 * Clip width from runtime.
 *
 * A linear mapping would be too extreme — the range is 33s to 128s, so the longest
 * clip would be nearly four times the shortest and the short ones would be too
 * small to read or click. A square-root curve keeps the relationship legible while
 * compressing the extremes.
 */
const durations = work.map((w) => w.data.duration ?? 60);
const minDur = Math.min(...durations);
const maxDur = Math.max(...durations);
const MIN_W = 190;
const MAX_W = 420;

const clipWidth = (duration?: number) => {
  const d = duration ?? 60;
  if (maxDur === minDur) return MIN_W;
  const t = (Math.sqrt(d) - Math.sqrt(minDur)) / (Math.sqrt(maxDur) - Math.sqrt(minDur));
  return Math.round(MIN_W + t * (MAX_W - MIN_W));
};

const timecode = (seconds?: number) => {
  if (!seconds) return '--:--';
  const m = Math.floor(seconds / 60);
  const s = seconds % 60;
  return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
};

const totalRuntime = durations.reduce((a, b) => a + b, 0);

const clips = work.map((entry, i) => ({
  index: i,
  slug: entry.id,
  title: entry.data.title,
  client: entry.data.client ?? null,
  category: entry.data.category,
  role: entry.data.role,
  vimeoId: entry.data.vimeoId,
  vimeoHash: entry.data.vimeoHash ?? null,
  ar: entry.data.width / entry.data.height,
  duration: entry.data.duration,
  width: clipWidth(entry.data.duration),
  poster: entry.data.poster,
  alt: entry.data.alt ?? entry.data.title,
  posterPosition: entry.data.posterPosition,
}));

const first = clips[0];
---

<Base
  title="Timeline"
  description={site.description}
  wide
  appShell
>
  <div class="suite">
    {/* ---------- Viewer ---------- */}
    <section class="viewer" aria-label="Viewer">
      <div class="viewer-frame" id="viewer-frame">
        <div class="viewer-stage" id="viewer-stage" style={`--ar: ${first.ar.toFixed(6)};`}>
          {/*
            Every poster is rendered, and all but the active one are hidden. This
            avoids a network request when switching clips — the images are already
            decoded — at the cost of some markup. Seventeen posters at these sizes
            is a fair trade for instant switching.
          */}
          {clips.map((clip) => (
            <Image
              src={clip.poster}
              alt={clip.alt}
              widths={[640, 1000, 1600]}
              sizes="(max-width: 60rem) 100vw, 70vw"
              loading={clip.index === 0 ? 'eager' : 'lazy'}
              class="viewer-poster"
              data-poster-for={clip.index}
              hidden={clip.index !== 0}
            />
          ))}

          <div class="viewer-player" id="viewer-player"></div>

          <button class="viewer-play" id="viewer-play" type="button">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
              <path d="M8 5.14v13.72L19 12 8 5.14Z" />
            </svg>
            <span class="visually-hidden">Play the selected clip</span>
          </button>
        </div>
      </div>

      {/* Clip metadata bar, styled after an NLE's source readout. */}
      <div class="readout">
        <div class="readout-main">
          <span class="readout-index" id="readout-index">01</span>
          <span class="readout-title" id="readout-title">{first.title}</span>
          {first.client && <span class="readout-client" id="readout-client">{first.client}</span>}
          {!first.client && <span class="readout-client" id="readout-client" hidden></span>}
        </div>
        <div class="readout-meta">
          <span class="readout-role" id="readout-role">{first.role}</span>
          <span class="readout-tc" id="readout-tc">{timecode(first.duration)}</span>
        </div>
      </div>
    </section>

    {/* ---------- Timeline ---------- */}
    <section class="timeline" aria-label="Timeline">
      <div class="timeline-head">
        <p class="timeline-label">
          Timeline
          <span class="timeline-count">{clips.length} clips</span>
          <span class="timeline-total">{timecode(totalRuntime)} total</span>
        </p>

        <div class="timeline-nav">
          <button type="button" class="tl-btn" data-nav="prev" aria-label="Previous clip">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M15 5l-7 7 7 7" />
            </svg>
          </button>
          <button type="button" class="tl-btn" data-nav="next" aria-label="Next clip">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>

      {/*
        A real listbox: roving selection, arrow-key navigation, aria-selected.
        Screen readers announce this as a list of choices, which is what it is.
      */}
      <div
        class="track"
        id="track"
        role="listbox"
        aria-label="Clips"
        tabindex="0"
        aria-activedescendant={`clip-0`}
      >
        <div class="track-inner">
          {clips.map((clip) => (
            <button
              type="button"
              class="clip"
              id={`clip-${clip.index}`}
              role="option"
              aria-selected={clip.index === 0 ? 'true' : 'false'}
              data-index={clip.index}
              data-vimeo-id={clip.vimeoId}
              data-vimeo-hash={clip.vimeoHash ?? ''}
              data-ar={clip.ar.toFixed(6)}
              data-title={clip.title}
              data-client={clip.client ?? ''}
              data-role={clip.role}
              data-tc={timecode(clip.duration)}
              style={`--clip-w: ${clip.width}px;`}
              tabindex="-1"
            >
              <span class="clip-thumb">
                <Image
                  src={clip.poster}
                  alt=""
                  widths={[280, 460, 700]}
                  sizes="420px"
                  loading={clip.index < 6 ? 'eager' : 'lazy'}
                  class="clip-img"
                  style={`object-position: ${clip.posterPosition};`}
                />
                <span class="clip-grade" aria-hidden="true"></span>
              </span>

              <span class="clip-label">
                <span class="clip-num">{String(clip.index + 1).padStart(2, '0')}</span>
                <span class="clip-name">{clip.title}</span>
                <span class="clip-tc">{timecode(clip.duration)}</span>
              </span>
            </button>
          ))}
        </div>
      </div>

      <p class="timeline-hint" id="timeline-hint">
        Scroll or use <kbd>←</kbd> <kbd>→</kbd> to move along the timeline
      </p>
    </section>
  </div>
</Base>

<script>
  const track = document.getElementById('track');
  const stage = document.getElementById('viewer-stage');
  const player = document.getElementById('viewer-player');
  const playBtn = document.getElementById('viewer-play');
  const hint = document.getElementById('timeline-hint');

  const readout = {
    index: document.getElementById('readout-index'),
    title: document.getElementById('readout-title'),
    client: document.getElementById('readout-client'),
    role: document.getElementById('readout-role'),
    tc: document.getElementById('readout-tc'),
  };

  const clips = Array.from(document.querySelectorAll<HTMLElement>('.clip'));

  if (track && stage && player && playBtn && clips.length) {
    let active = 0;
    let playing = false;

    const posterFor = (i: number) =>
      document.querySelector<HTMLElement>(`[data-poster-for="${i}"]`);

    /** Tear down the player and show the poster again. */
    const stopPlayback = () => {
      player.replaceChildren();
      playing = false;
      playBtn.hidden = false;
      posterFor(active)?.removeAttribute('hidden');
    };

    const play = () => {
      const clip = clips[active];
      const id = clip.dataset.vimeoId;
      if (!id) return;

      const params = new URLSearchParams({
        autoplay: '1',
        title: '0',
        byline: '0',
        portrait: '0',
        dnt: '1',
      });
      // Unlisted videos will not play without their privacy hash.
      if (clip.dataset.vimeoHash) params.set('h', clip.dataset.vimeoHash);

      const iframe = document.createElement('iframe');
      iframe.src = `https://player.vimeo.com/video/${id}?${params}`;
      iframe.title = clip.dataset.title || 'Vimeo player';
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.allowFullscreen = true;

      // Only ever one iframe on the page.
      player.replaceChildren(iframe);
      posterFor(active)?.setAttribute('hidden', '');
      playBtn.hidden = true;
      playing = true;
    };

    /** Select a clip. `autoplay` mirrors NLE behaviour: clicking a clip plays it. */
    const select = (next: number, { autoplay = false, scroll = true } = {}) => {
      const i = Math.max(0, Math.min(clips.length - 1, next));
      const clip = clips[i];
      const wasPlaying = playing;

      // Swap posters before anything else so there's never a blank frame.
      posterFor(active)?.setAttribute('hidden', '');
      active = i;
      stopPlayback();

      stage.style.setProperty('--ar', clip.dataset.ar ?? '1.7778');

      readout.index!.textContent = String(i + 1).padStart(2, '0');
      readout.title!.textContent = clip.dataset.title ?? '';
      readout.role!.textContent = clip.dataset.role ?? '';
      readout.tc!.textContent = clip.dataset.tc ?? '';

      const client = clip.dataset.client;
      if (client) {
        readout.client!.textContent = client;
        readout.client!.hidden = false;
      } else {
        readout.client!.textContent = '';
        readout.client!.hidden = true;
      }

      clips.forEach((c, n) => c.setAttribute('aria-selected', n === i ? 'true' : 'false'));
      track.setAttribute('aria-activedescendant', clip.id);

      if (scroll) {
        clip.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }

      if (autoplay || wasPlaying) play();
    };

    clips.forEach((clip, i) => {
      clip.addEventListener('click', () => {
        // Clicking the already-playing clip shouldn't restart it.
        if (i === active && playing) return;
        select(i, { autoplay: true });
        hint?.setAttribute('data-used', '');
      });
    });

    playBtn.addEventListener('click', play);

    /*
     * Vertical wheel drives horizontal movement. The page is exactly one viewport
     * tall, so there is no vertical scroll to steal — this is a translation of the
     * gesture, not an override of it. A native horizontal gesture (trackpad
     * two-finger sideways) is left alone, since it already does the right thing.
     */
    track.addEventListener(
      'wheel',
      (event) => {
        if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
        const maxScroll = track.scrollWidth - track.clientWidth;
        if (maxScroll <= 0) return;
        event.preventDefault();
        track.scrollLeft += event.deltaY;
        hint?.setAttribute('data-used', '');
      },
      { passive: false }
    );

    // Wheel anywhere in the viewer area also moves the timeline, so the gesture
    // works without having to aim at the strip first.
    document.querySelector('.viewer')?.addEventListener(
      'wheel',
      (event) => {
        const e = event as WheelEvent;
        if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
        const maxScroll = track.scrollWidth - track.clientWidth;
        if (maxScroll <= 0) return;
        e.preventDefault();
        track.scrollLeft += e.deltaY;
      },
      { passive: false }
    );

    document.querySelectorAll<HTMLElement>('[data-nav]').forEach((btn) => {
      btn.addEventListener('click', () => {
        select(active + (btn.dataset.nav === 'next' ? 1 : -1), { autoplay: playing });
        hint?.setAttribute('data-used', '');
      });
    });

    /* Keyboard: arrows move, Enter/Space plays, Escape stops. */
    const onKey = (event: KeyboardEvent) => {
      switch (event.key) {
        case 'ArrowRight':
          event.preventDefault();
          select(active + 1);
          hint?.setAttribute('data-used', '');
          break;
        case 'ArrowLeft':
          event.preventDefault();
          select(active - 1);
          hint?.setAttribute('data-used', '');
          break;
        case 'Home':
          event.preventDefault();
          select(0);
          break;
        case 'End':
          event.preventDefault();
          select(clips.length - 1);
          break;
        case 'Enter':
        case ' ':
          if (document.activeElement === track) {
            event.preventDefault();
            play();
          }
          break;
        case 'Escape':
          if (playing) {
            event.preventDefault();
            stopPlayback();
          }
          break;
      }
    };

    track.addEventListener('keydown', onKey);

    /*
     * The same keys work without having to focus the timeline first. Safe here
     * because the page is an app shell with no vertical scroll, so Home/End and
     * the arrows have no competing default behaviour to take away. Form fields are
     * still excluded, and modifier combinations are left to the browser so
     * shortcuts like Cmd+Left (back) keep working.
     */
    const GLOBAL_KEYS = ['ArrowLeft', 'ArrowRight', 'Home', 'End', 'Escape'];

    document.addEventListener('keydown', (event) => {
      const el = document.activeElement;
      if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) return;
      if (el === track) return; // the listbox handler already ran
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      if (GLOBAL_KEYS.includes(event.key)) onKey(event);
    });
  }
</script>

<style>
  .suite {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    gap: 0;
  }

  /* ---------- Viewer ---------- */
  .viewer {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding: var(--s-4) var(--gutter) 0;
  }

  .viewer-frame {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Size container so the stage can fit itself on whichever axis binds. */
    container-type: size;
  }

  /*
   * Fit a known ratio inside the frame. `width: 100%` plus `max-height` does NOT
   * preserve aspect ratio when height binds — computing the width explicitly does.
   */
  .viewer-stage {
    position: relative;
    aspect-ratio: var(--ar, 1.7778);
    width: min(100cqw, calc(100cqh * var(--ar, 1.7778)));
    background: #000;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: aspect-ratio var(--dur-base) var(--ease);
  }

  @supports not (width: 1cqh) {
    .viewer-stage { width: 100%; max-width: 100%; }
  }

  /*
   * `cover`, not `contain`. The stage is already sized to the video's ratio, but
   * several posters were cropped to their content ratio (a 2.39:1 film delivered
   * in a 16:9 container), so `contain` would letterbox the poster inside a stage
   * that is itself the right shape — bars on top of bars. `cover` fills the frame
   * and trims a sliver of width instead, which is what a program monitor looks like.
   */
  .viewer-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .viewer-poster[hidden] { display: none; }

  .viewer-player { position: absolute; inset: 0; }

  .viewer-player :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .viewer-play {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--c-bg) 45%, transparent);
    backdrop-filter: blur(8px);
    border: 1px solid var(--c-line-strong);
    color: var(--c-text);
    cursor: pointer;
    transition: scale var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }

  .viewer-play svg { translate: 2px 0; }
  .viewer-play:hover { scale: 1.06; background: color-mix(in srgb, var(--c-bg) 25%, transparent); }
  .viewer-play[hidden] { display: none; }

  /* ---------- Readout ---------- */
  .readout {
    flex: 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-2) var(--s-5);
    padding: var(--s-4) 0 var(--s-3);
  }

  .readout-main {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-3);
    min-width: 0;
  }

  .readout-index {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: var(--c-text-faint);
  }

  .readout-title {
    font-size: var(--t-lg);
    color: var(--c-text);
  }

  .readout-client {
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--c-text-muted);
  }

  .readout-client[hidden] { display: none; }

  .readout-meta {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    font-size: var(--t-xs);
    color: var(--c-text-faint);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .readout-tc {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
  }

  /* ---------- Timeline ---------- */
  .timeline {
    flex: 0 0 auto;
    border-top: 1px solid var(--c-line);
    background: color-mix(in srgb, var(--c-bg-raised) 60%, var(--c-bg));
    padding-block: var(--s-3) var(--s-3);
  }

  .timeline-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-inline: var(--gutter);
    margin-bottom: var(--s-3);
  }

  .timeline-label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-3);
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--c-text-muted);
  }

  .timeline-count,
  .timeline-total {
    color: var(--c-text-faint);
    letter-spacing: var(--tracking-wide);
  }

  .timeline-nav { display: flex; gap: var(--s-2); }

  .tl-btn {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background: none;
    color: var(--c-text-muted);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .tl-btn:hover { color: var(--c-text); border-color: var(--c-line-strong); }

  .track {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: var(--c-line-strong) transparent;
    padding-inline: var(--gutter);
    padding-bottom: var(--s-2);
  }

  .track:focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: -2px;
  }

  .track::-webkit-scrollbar { height: 6px; }
  .track::-webkit-scrollbar-track { background: transparent; }
  .track::-webkit-scrollbar-thumb {
    background: var(--c-line-strong);
    border-radius: 3px;
  }

  .track-inner {
    display: flex;
    gap: 3px; /* tight, like abutting clips on a real timeline */
    width: max-content;
  }

  /* ---------- Clip ---------- */
  .clip {
    flex: 0 0 auto;
    /* Width is proportional to runtime — the point of the metaphor. */
    width: var(--clip-w, 240px);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
    scroll-snap-align: center;
    display: block;
    -webkit-tap-highlight-color: transparent;
  }

  .clip-thumb {
    position: relative;
    display: block;
    /* Uniform height across all clips; only width varies. Tall enough that the
       frames are actually readable — at 74px the strip read as a scrollbar rather
       than as a timeline. */
    height: clamp(92px, 15vh, 168px);
    overflow: hidden;
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--c-bg-raised);
    border: 1px solid var(--c-line);
    border-bottom: 0;
  }

  .clip-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.55) brightness(0.6);
    transition: filter var(--dur-base) var(--ease);
  }

  .clip-grade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(6, 6, 7, 0.55), transparent 70%);
  }

  .clip-label {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    padding: 5px var(--s-2) 6px;
    border: 1px solid var(--c-line);
    border-top: 0;
    border-radius: 0 0 var(--radius) var(--radius);
    background: var(--c-bg-raised);
    overflow: hidden;
    transition: background var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .clip-num {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--c-text-faint);
  }

  .clip-name {
    flex: 1 1 auto;
    font-size: var(--t-xs);
    color: var(--c-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .clip-tc {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--c-text-faint);
    font-variant-numeric: tabular-nums;
  }

  /* Hover: bring the frame up out of the grade. */
  .clip:hover .clip-img { filter: saturate(0.85) brightness(0.85); }
  .clip:hover .clip-name { color: var(--c-text); }

  /* Selected clip — the equivalent of a timeline's active clip. */
  .clip[aria-selected='true'] .clip-thumb {
    border-color: var(--c-text);
  }

  .clip[aria-selected='true'] .clip-img {
    filter: saturate(1) brightness(1);
  }

  .clip[aria-selected='true'] .clip-label {
    background: var(--c-text);
    border-color: var(--c-text);
  }

  .clip[aria-selected='true'] .clip-name { color: var(--c-bg); }
  .clip[aria-selected='true'] .clip-num,
