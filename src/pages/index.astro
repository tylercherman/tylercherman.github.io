---
/**
 * Homepage — the work grid.
 *
 * Work is the homepage, matching the current site. All pieces in one grid: no
 * category filters, no separate sections, metadata secondary. PLAN.md §6.1.
 *
 * The grid deliberately lets the five aspect ratios (16:9, 9:16, 1:1, 2.35:1, 2:1)
 * read as rhythm rather than forcing them into uniform boxes the way Squarespace
 * does now.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkTile from '../components/WorkTile.astro';
import Lightbox from '../components/Lightbox.astro';
import site from '../data/site.json';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

/** Classify each piece so the grid can give it appropriate room. */
const spanOf = (w: number, h: number) => {
  const r = w / h;
  if (r < 0.9) return 'tall';   // 9:16
  if (r < 1.1) return 'square'; // 1:1
  if (r > 2.2) return 'scope';  // 2.35:1 and wider
  return 'wide';                // 16:9, 2:1
};
---

<Base title="Work" description={site.description} wide>
  <h1 class="visually-hidden">{site.name} — selected work</h1>

  <div class="grid-wrap wrap">
    <ul class="grid">
      {work.map((entry, i) => (
        <li class={`cell cell--${spanOf(entry.data.width, entry.data.height)}`}>
          <WorkTile entry={entry} priority={i < 3} />
        </li>
      ))}
    </ul>
  </div>

  <Lightbox />
</Base>

<style>
  .grid-wrap {
    padding-block: var(--s-5) var(--s-8);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grid-gap);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cell { min-width: 0; }

  /* Two columns from ~40rem. Each tile sizes to its own ratio, so verticals
     read taller than landscape without any extra rules. */
  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      align-items: start;
    }

    /* Ultra-wide pieces earn a full row rather than being shown postage-stamp
       small beside a vertical. */
    .cell--scope { grid-column: 1 / -1; }
  }

  @media (min-width: 70rem) {
    .grid { grid-template-columns: repeat(6, 1fr); }

    /* 6-column system: landscape = half, vertical/square = a third,
       scope = full bleed. Variety without anything looking accidental. */
    .cell--wide   { grid-column: span 3; }
    .cell--tall   { grid-column: span 2; }
    .cell--square { grid-column: span 2; }
    .cell--scope  { grid-column: span 6; }
  }
</style>
