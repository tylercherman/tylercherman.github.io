---
/**
 * Homepage — full-bleed hero, then the work grid.
 *
 * Restructured to follow tashitrieu.com: a full-viewport hero, then a titled
 * section of uniform 16:9 thumbnails, three across.
 *
 * The tiles are cropped to a single ratio for tidiness; the lightbox still plays
 * every piece at its true aspect ratio, so the verticals and squares are shown
 * properly once opened.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import WorkTile from '../components/WorkTile.astro';
import Lightbox from '../components/Lightbox.astro';
import site from '../data/site.json';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title="Work" description={site.description} wide transparentHeader>
  <Hero />

  <section class="work-section" id="work" aria-labelledby="work-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2 class="section-title" id="work-h">{site.work.heading}</h2>
          {/* Moved down from the hero — the formats mean more next to the work
              than they do over the video. */}
          <p class="section-subhead">{site.work.subhead}</p>
        </div>
        <p class="section-count">{work.length} pieces</p>
      </div>

      <ul class="grid">
        {work.map((entry, i) => (
          <li>
            <WorkTile entry={entry} priority={i < 3} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Lightbox />
</Base>

<style>
  .work-section { padding-block: var(--s-8) var(--s-9); }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-4);
    margin-bottom: var(--s-6);
  }

  .section-title {
    font-size: var(--t-xl);
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  .section-subhead {
    margin-top: var(--s-2);
    font-size: var(--t-sm);
    color: var(--c-text-muted);
  }

  .section-count {
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--c-text-faint);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--grid-gap);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Uniform tiles mean a plain column count is all that's needed — no span
     rules, no ratio special-casing. */
  @media (min-width: 40rem) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 64rem) {
    .grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
