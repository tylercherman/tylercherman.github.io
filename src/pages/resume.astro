---
/**
 * Resume page.
 *
 * Driven entirely by src/data/resume.json — edit that file and this page follows.
 *
 * Currently renders Selected Credits, then Education and Skills. The Experience
 * section and the "Download PDF" button were both removed at Tyler's request; the
 * underlying data and the PDF file are still present, so either can come back
 * without retyping anything.
 *
 * This page carries more weight than a resume page normally would: with no credits
 * banner on the homepage (PLAN.md §6.3), it is the ONLY place the HBO Max, Netflix,
 * Nike, Amazon Studios, Showtime and Oscar credits appear. It's also the densest
 * indexable text on the site, which matters for the local-search goal in §10.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import resume from '../data/resume.json';
import site from '../data/site.json';
import copy from '../data/copy.json';
import headshot from '../assets/tyler-cherman-headshot.jpg';

const description =
  `Resume and selected credits for ${resume.name}, ${resume.title.replace(/\.$/, '')} ` +
  `based in ${resume.location} — trailers, commercials, series and documentary for ` +
  `HBO Max, Netflix, Nike, Adidas, Amazon Studios, Showtime and A&E.`;

/** Compose the "Type — Client" line, skipping whichever part is missing. */
const credited = (c: (typeof resume.credits)[number]) =>
  [c.type, c.client].filter(Boolean).join(' · ');

/*
 * The email address is base64-encoded here and assembled by script in the browser, so
 * it never appears in the page source as readable text or as a mailto: href.
 *
 * This is not encryption and isn't meant to be — base64 is trivially reversible. It
 * defeats the bulk harvesters that regex a page for `mailto:` or an @-pattern, which is
 * where address-scraping spam actually comes from. A scraper written specifically to
 * target this site would get through, but nobody is doing that.
 *
 * Without JavaScript the link falls back to the contact form, so there is always a
 * route to reach Tyler.
 */
const encodedEmail = Buffer.from(resume.email, 'utf8').toString('base64');
---

<Base title="Resume" description={description} wide>
  <div class="resume wrap">
    <header class="resume-head" data-reveal>
      {/*
        The headshot, sized to match the text block beside it. It only ever renders
        at 74–96px wide, so its modest 396px source is more than enough here — this
        is a better home for it than the About page, where it was displayed near
        native size and had no resolution to spare.
      */}
      <figure class="resume-figure">
        <Image
          src={headshot}
          alt={`${site.name}, editor and movie maker based in Portland, Oregon.`}
          widths={[150, 220, 300]}
          sizes="(max-width: 40rem) 74px, 96px"
          loading="eager"
          class="resume-photo"
        />
      </figure>

      <div class="resume-identity">
        <h1 class="resume-name">{resume.name}</h1>
        <p class="resume-title">{resume.title}</p>
        <p class="resume-contact">
          <span>{resume.location}</span>
          <span aria-hidden="true">·</span>
          {/*
            Falls back to the contact form; the script swaps in a mailto: and the
            address itself once the page is live.
          */}
          <a class="js-email" href="/contact" data-e={encodedEmail}>Email</a>
        </p>
      </div>
    </header>

    <section class="section" data-reveal style="--reveal-delay: 60ms;" aria-labelledby="credits-h">
      <h2 class="section-h label" id="credits-h">Selected Credits</h2>
      <ul class="credits">
        {resume.credits.map((c) => (
          <li class="credit">
            <span class="credit-project">
              {c.project}
              {c.note && <span class="credit-note">{c.note}</span>}
            </span>
            <span class="credit-type">{credited(c)}</span>
            <span class="credit-role">{c.role}</span>
          </li>
        ))}
      </ul>
    </section>

    {/*
      The Experience section is removed at Tyler's request — the page now runs
      Selected Credits straight into Education and Skills. The four roles are still in
      resume.json, so bringing it back is restoring this markup rather than retyping
      anything.
    */}

    <div class="section-split">
      <section class="section" data-reveal style="--reveal-delay: 120ms;" aria-labelledby="education-h">
        <h2 class="section-h label" id="education-h">Education</h2>
        <p class="edu">
          <strong>{resume.education.school}</strong><br />
          {resume.education.degree}, {resume.education.year}
        </p>
      </section>

      <section class="section" data-reveal style="--reveal-delay: 180ms;" aria-labelledby="skills-h">
        <h2 class="section-h label" id="skills-h">Skills</h2>
        <dl class="skills">
          {Object.entries(resume.skills).map(([name, detail]) => (
            <div class="skill">
              <dt>{name}</dt>
              <dd>{detail}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>

    {resume.epigraph && (
      <figure class="epigraph">
        <blockquote>“{resume.epigraph.quote}”</blockquote>
        <figcaption>— {resume.epigraph.attribution}</figcaption>
      </figure>
    )}

    <p class="resume-foot">
      <a href="/">{copy.links.seeTheWork}</a>
      <span aria-hidden="true">·</span>
      <a href="/contact">{copy.links.getInTouch}</a>
    </p>
  </div>
</Base>

<script>
  /*
   * Assemble the email address client-side. See the note in the frontmatter for why:
   * it keeps the address out of the page source, where bulk harvesters read it.
   */
  document.querySelectorAll<HTMLAnchorElement>('a.js-email').forEach((el) => {
    const encoded = el.dataset.e;
    if (!encoded) return;
    try {
      const address = atob(encoded);
      el.href = `mailto:${address}`;
      el.textContent = address;
    } catch {
      // Decoding failed for some reason — leave the contact-form fallback in place
      // rather than showing a broken link.
    }
  });
</script>

<style>
  .resume {
    padding-block: var(--s-7) var(--s-9);
    max-width: 68rem;
  }

  /* ---------- Head ----------
     `align-items: stretch` makes the figure exactly as tall as the identity block, so
     the photo's top edge meets the top of the name and its base meets the last line
     of contact detail. The photo's width then derives from that height. */
  .resume-head {
    display: flex;
    align-items: stretch;
    gap: clamp(var(--s-4), 2.5vw, var(--s-6));
    padding-bottom: var(--s-6);
    border-bottom: 1px solid var(--c-line);
  }

  /*
   * The TEXT sets the height and the photo follows it.
   *
   * That ordering has to be forced. With the image in normal flow its intrinsic
   * height drives the flex line, so the photo ended up taller than the text it was
   * meant to match. Positioning the image absolutely removes it from that
   * calculation: the figure then stretches to whatever height the identity block
   * needs, and `aspect-ratio` derives the width from it.
   */
  /*
   * Width is set explicitly rather than derived from aspect-ratio. As a flex item
   * with an absolutely-positioned child there is no content to size from, so
   * `flex-basis: auto` resolves the width to zero and aspect-ratio never gets a
   * chance. A fixed width with a stretched height is both simpler and more robust.
   *
   * ~93px is what the source's 0.75 ratio wants at this text height, so `cover`
   * crops essentially nothing at desktop. If the name wraps on a narrow screen the
   * block grows taller and cover trims the sides gracefully.
   */
  .resume-figure {
    margin: 0;
    flex: 0 0 auto;
    position: relative;
    align-self: stretch;
    width: clamp(74px, 7vw, 96px);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .resume-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    display: block;
  }

  .resume-identity { min-width: 0; }

  /*
   * Same display face as the hero name, so the two pages read as one system — but
   * deliberately NOT the hero's tracking. The hero runs at --tracking-display
   * (-0.045em), which suits a 144px headline where tight letterfitting reads as
   * confident. At this size that same value crowded the letters, so it's opened up.
   */
  .resume-name {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.2vw + 1.1rem, 3.25rem);
    font-weight: var(--weight-display);
    letter-spacing: -0.015em;
    line-height: 1;
  }

  .resume-title {
    color: var(--c-text-muted);
    font-size: var(--t-lg);
    margin-top: var(--s-2);
  }

  .resume-contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-3);
    font-size: var(--t-sm);
    color: var(--c-text-muted);
  }

  .resume-contact a { border-bottom: 1px solid var(--c-line-strong); }
  .resume-contact a:hover { color: var(--c-text); }

  /* Narrow columns force the location and email onto separate lines, which leaves the
     "·" dangling at the end of the first one. Stack them and drop the separator. */
  @media (max-width: 34rem) {
    .resume-contact {
      flex-direction: column;
      gap: 2px;
    }

    .resume-contact span[aria-hidden] { display: none; }
  }

  /* ---------- Sections ---------- */
  .section { margin-top: var(--s-8); }

  .section-h {
    padding-bottom: var(--s-3);
    margin-bottom: var(--s-5);
    border-bottom: 1px solid var(--c-line);
  }

  /* ---------- Credits ---------- */
  .credits {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-1);
  }

  .credit {
    display: grid;
    gap: var(--s-1) var(--s-5);
    padding: var(--s-3) 0;
    border-bottom: 1px solid color-mix(in srgb, var(--c-line) 55%, transparent);
  }

  @media (min-width: 46rem) {
    .credit {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr) minmax(0, 0.7fr);
      align-items: baseline;
    }
  }

  .credit-project {
    color: var(--c-text);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2);
  }

  /* The Oscar notes. Stated once, quietly — no badge, no emphasis colour. */
  .credit-note {
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--c-text-faint);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    padding: 1px var(--s-2);
  }

  .credit-type,
  .credit-role {
    font-size: var(--t-sm);
    color: var(--c-text-muted);
  }

  .credit-role { font-variant-numeric: tabular-nums; }

  /* ---------- Education + Skills ---------- */
  .section-split { display: grid; gap: 0; }

  @media (min-width: 52rem) {
    .section-split {
      grid-template-columns: minmax(0, 0.6fr) minmax(0, 1fr);
      gap: var(--s-8);
      align-items: start;
    }
  }

  .edu { color: var(--c-text-muted); }
  .edu strong { color: var(--c-text); font-weight: 500; }

  .skills { display: grid; gap: var(--s-4); margin: 0; }

  .skill dt {
    font-size: var(--t-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--c-text);
  }

  .skill dd {
    margin: var(--s-1) 0 0;
    color: var(--c-text-muted);
  }

  /* ---------- Epigraph ---------- */
  .epigraph {
    margin: var(--s-9) 0 0;
    padding-top: var(--s-6);
    border-top: 1px solid var(--c-line);
    text-align: center;
  }

  .epigraph blockquote {
    font-size: var(--t-xl);
    font-style: italic;
    color: var(--c-text);
    max-width: 34rem;
    margin-inline: auto;
    text-wrap: balance;
  }

  .epigraph figcaption {
    margin-top: var(--s-3);
    font-size: var(--t-sm);
    color: var(--c-text-faint);
  }

  /* ---------- Foot ---------- */
  .resume-foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-8);
    font-size: var(--t-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--c-text-faint);
  }

  .resume-foot a {
    color: var(--c-text-muted);
    border-bottom: 1px solid var(--c-line-strong);
  }

  .resume-foot a:hover { color: var(--c-text); border-color: var(--c-text); }
</style>
