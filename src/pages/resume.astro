---
/**
 * Resume page.
 *
 * Driven entirely by src/data/resume.json — edit that file and this page follows.
 *
 * Currently renders Selected Credits, then Education and Skills. The Experience
 * section and the "Download PDF" button were both removed at Tyler's request; the
 * underlying data and the PDF file are still present, so either can come back
 * without retyping anything.
 *
 * This page carries more weight than a resume page normally would: with no credits
 * banner on the homepage (PLAN.md §6.3), it is the ONLY place the HBO Max, Netflix,
 * Nike, Amazon Studios, Showtime and Oscar credits appear. It's also the densest
 * indexable text on the site, which matters for the local-search goal in §10.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import resume from '../data/resume.json';
import site from '../data/site.json';
import copy from '../data/copy.json';
import analog from '../assets/analog.jpg';

const description =
  `Resume and selected credits for ${resume.name}, ${resume.title.replace(/\.$/, '')} ` +
  `based in ${resume.location} — trailers, commercials, series and documentary for ` +
  `HBO Max, Netflix, Nike, Adidas, Amazon Studios, Showtime and A&E.`;

/** Compose the "Type — Client" line, skipping whichever part is missing. */
const credited = (c: (typeof resume.credits)[number]) =>
  [c.type, c.client].filter(Boolean).join(' · ');
---

<Base title="Resume" description={description} wide>
  <div class="resume wrap">
    <header class="resume-head" data-reveal>
      {/*
        The Analog portrait sits in the header rather than on the Contact page. It
        fills the space the "Download PDF" button used to occupy, and unlike on
        Contact it doesn't compete with a form for attention — so it can stay visible
        on phones instead of being hidden at narrow widths.
      */}
      <figure class="resume-figure">
        <Image
          src={analog}
          alt={`${site.name} seated on a vintage CRT monitor showing the same shot with burned-in timecode.`}
          widths={[180, 300, 420]}
          sizes="(max-width: 40rem) 96px, 150px"
          loading="eager"
          class="resume-photo"
        />
      </figure>

      <div class="resume-identity">
        <h1 class="resume-name">{resume.name}</h1>
        <p class="resume-title">{resume.title}</p>
        <p class="resume-contact">
          <span>{resume.location}</span>
          <span aria-hidden="true">·</span>
          <a href={`mailto:${resume.email}`}>{resume.email}</a>
        </p>
      </div>
    </header>

    <section class="section" data-reveal style="--reveal-delay: 60ms;" aria-labelledby="credits-h">
      <h2 class="section-h label" id="credits-h">Selected Credits</h2>
      <ul class="credits">
        {resume.credits.map((c) => (
          <li class="credit">
            <span class="credit-project">
              {c.project}
              {c.note && <span class="credit-note">{c.note}</span>}
            </span>
            <span class="credit-type">{credited(c)}</span>
            <span class="credit-role">{c.role}</span>
          </li>
        ))}
      </ul>
    </section>

    {/*
      The Experience section is removed at Tyler's request — the page now runs
      Selected Credits straight into Education and Skills. The four roles are still in
      resume.json, so bringing it back is restoring this markup rather than retyping
      anything.
    */}

    <div class="section-split">
      <section class="section" data-reveal style="--reveal-delay: 120ms;" aria-labelledby="education-h">
        <h2 class="section-h label" id="education-h">Education</h2>
        <p class="edu">
          <strong>{resume.education.school}</strong><br />
          {resume.education.degree}, {resume.education.year}
        </p>
      </section>

      <section class="section" data-reveal style="--reveal-delay: 180ms;" aria-labelledby="skills-h">
        <h2 class="section-h label" id="skills-h">Skills</h2>
        <dl class="skills">
          {Object.entries(resume.skills).map(([name, detail]) => (
            <div class="skill">
              <dt>{name}</dt>
              <dd>{detail}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>

    {resume.epigraph && (
      <figure class="epigraph">
        <blockquote>“{resume.epigraph.quote}”</blockquote>
        <figcaption>— {resume.epigraph.attribution}</figcaption>
      </figure>
    )}

    <p class="resume-foot">
      <a href="/">{copy.links.seeTheWork}</a>
      <span aria-hidden="true">·</span>
      <a href="/contact">{copy.links.getInTouch}</a>
    </p>
  </div>
</Base>

<style>
  .resume {
    padding-block: var(--s-7) var(--s-9);
    max-width: 68rem;
  }

  /* ---------- Head ----------
     Photo and identity sit side by side, bottom-aligned so the portrait's base lines
     up with the last line of text rather than floating. */
  .resume-head {
    display: flex;
    align-items: flex-end;
    gap: clamp(var(--s-4), 2.5vw, var(--s-6));
    padding-bottom: var(--s-6);
    border-bottom: 1px solid var(--c-line);
  }

  .resume-figure {
    margin: 0;
    flex: 0 0 auto;
    width: clamp(96px, 12vw, 150px);
  }

  .resume-photo {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    display: block;
  }

  .resume-identity { min-width: 0; }

  .resume-name {
    font-size: var(--t-2xl);
    font-weight: 400;
    letter-spacing: -0.015em;
  }

  .resume-title {
    color: var(--c-text-muted);
    font-size: var(--t-lg);
  }

  .resume-contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-3);
    font-size: var(--t-sm);
    color: var(--c-text-muted);
  }

  .resume-contact a { border-bottom: 1px solid var(--c-line-strong); }
  .resume-contact a:hover { color: var(--c-text); }

  /* Narrow columns force the location and email onto separate lines, which leaves the
     "·" dangling at the end of the first one. Stack them and drop the separator. */
  @media (max-width: 34rem) {
    .resume-contact {
      flex-direction: column;
      gap: 2px;
    }

    .resume-contact span[aria-hidden] { display: none; }
  }

  /* ---------- Sections ---------- */
  .section { margin-top: var(--s-8); }

  .section-h {
    padding-bottom: var(--s-3);
    margin-bottom: var(--s-5);
    border-bottom: 1px solid var(--c-line);
  }

  /* ---------- Credits ---------- */
  .credits {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-1);
  }

  .credit {
    display: grid;
    gap: var(--s-1) var(--s-5);
    padding: var(--s-3) 0;
    border-bottom: 1px solid color-mix(in srgb, var(--c-line) 55%, transparent);
  }

  @media (min-width: 46rem) {
    .credit {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr) minmax(0, 0.7fr);
      align-items: baseline;
    }
  }

  .credit-project {
    color: var(--c-text);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2);
  }

  /* The Oscar notes. Stated once, quietly — no badge, no emphasis colour. */
  .credit-note {
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--c-text-faint);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    padding: 1px var(--s-2);
  }

  .credit-type,
  .credit-role {
    font-size: var(--t-sm);
    color: var(--c-text-muted);
  }

  .credit-role { font-variant-numeric: tabular-nums; }

  /* ---------- Education + Skills ---------- */
  .section-split { display: grid; gap: 0; }

  @media (min-width: 52rem) {
    .section-split {
      grid-template-columns: minmax(0, 0.6fr) minmax(0, 1fr);
      gap: var(--s-8);
      align-items: start;
    }
  }

  .edu { color: var(--c-text-muted); }
  .edu strong { color: var(--c-text); font-weight: 500; }

  .skills { display: grid; gap: var(--s-4); margin: 0; }

  .skill dt {
    font-size: var(--t-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--c-text);
  }

  .skill dd {
    margin: var(--s-1) 0 0;
    color: var(--c-text-muted);
  }

  /* ---------- Epigraph ---------- */
  .epigraph {
    margin: var(--s-9) 0 0;
    padding-top: var(--s-6);
    border-top: 1px solid var(--c-line);
    text-align: center;
  }

  .epigraph blockquote {
    font-size: var(--t-xl);
    font-style: italic;
    color: var(--c-text);
    max-width: 34rem;
    margin-inline: auto;
    text-wrap: balance;
  }

  .epigraph figcaption {
    margin-top: var(--s-3);
    font-size: var(--t-sm);
    color: var(--c-text-faint);
  }

  /* ---------- Foot ---------- */
  .resume-foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-8);
    font-size: var(--t-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--c-text-faint);
  }

  .resume-foot a {
    color: var(--c-text-muted);
    border-bottom: 1px solid var(--c-line-strong);
  }

  .resume-foot a:hover { color: var(--c-text); border-color: var(--c-text); }
</style>
