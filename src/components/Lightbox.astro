---
/**
 * Video lightbox.
 *
 * The whole point: exactly ONE Vimeo iframe exists on the page, and only after a
 * click. The old Squarespace homepage eagerly loaded 14 players, each pulling its
 * own copy of Vimeo's player bundle — that is why it was slow and why the layout
 * shifted around. See PLAN.md §2.
 *
 * The iframe is created on open and removed on close, so closing actually stops
 * playback and releases the player rather than leaving it running unseen.
 */
---

<dialog id="lightbox" class="lightbox" aria-label="Video player">
  <div class="lightbox-inner">
    <div class="lightbox-bar">
      <p class="lightbox-title" id="lightbox-title"></p>
      <button type="button" class="lightbox-close" data-close aria-label="Close video">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <div class="lightbox-frame">
      <!-- Stage carries the video's aspect ratio so a vertical piece gets a tall
           frame rather than a 16:9 box with bars down the sides. -->
      <div class="lightbox-stage" id="lightbox-stage"></div>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const stage = document.getElementById('lightbox-stage');
  const titleEl = document.getElementById('lightbox-title');

  if (dialog && stage && titleEl) {
    let lastFocused: HTMLElement | null = null;

    const open = (tile: HTMLElement) => {
      const id = tile.dataset.vimeoId;
      if (!id) return;

      const hash = tile.dataset.vimeoHash;
      const title = tile.dataset.title ?? '';

      lastFocused = tile;
      titleEl.textContent = title;
      // Numeric ratio: the stage does arithmetic with it to fit the player
      // inside the frame on whichever axis binds first.
      stage.style.setProperty('--ar', tile.dataset.ar ?? '1.7778');

      const params = new URLSearchParams({
        autoplay: '1',
        title: '0',
        byline: '0',
        portrait: '0',
        dnt: '1',
      });
      // Unlisted videos will not play without their privacy hash.
      if (hash) params.set('h', hash);

      const iframe = document.createElement('iframe');
      iframe.src = `https://player.vimeo.com/video/${id}?${params}`;
      iframe.title = title || 'Vimeo video player';
      iframe.allow = 'autoplay; fullscreen; picture-in-picture';
      iframe.allowFullscreen = true;

      stage.replaceChildren(iframe);
      dialog.showModal();
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      // Removing the iframe stops playback and frees the player.
      stage.replaceChildren();
      document.body.style.overflow = '';
      if (dialog.open) dialog.close();
      lastFocused?.focus();
      lastFocused = null;
    };

    document.querySelectorAll<HTMLElement>('.tile').forEach((tile) => {
      tile.addEventListener('click', () => open(tile));
    });

    dialog.querySelectorAll('[data-close]').forEach((btn) => {
      btn.addEventListener('click', close);
    });

    // Backdrop click (outside the inner panel) closes.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });

    // Esc fires dialog's native cancel — intercept so the iframe is cleared too.
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });
  }
</script>

<style>
  /*
   * The UA stylesheet gives dialog `margin: auto` and a max-height of roughly
   * `calc(100% - 6px - 2em)`, which shrinks the box and pushes the player off
   * centre. All of it has to be overridden explicitly.
   * 100dvh (not vh) so mobile browser chrome doesn't crop the bottom.
   */
  .lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
  }

  .lightbox::backdrop {
    background: var(--c-bg-overlay);
    backdrop-filter: blur(8px);
  }

  .lightbox-inner {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    width: 100%;
    height: 100%;
    padding: clamp(0.75rem, 3vw, 2rem);
  }

  .lightbox-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    flex: 0 0 auto;
  }

  .lightbox-title {
    font-size: var(--t-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--c-text);
  }

  .lightbox-close {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--c-line-strong);
    border-radius: 50%;
    background: none;
    color: var(--c-text-muted);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }

  .lightbox-close:hover {
    color: var(--c-text);
    border-color: var(--c-text);
  }

  .lightbox-frame {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    /* Establishes a size container so the stage can measure this box in cqw/cqh. */
    container-type: size;
  }

  /*
   * Fitting a known aspect ratio inside a box, correctly.
   *
   * `width: 100%` + `max-height: 100%` does NOT work: when max-height binds, the
   * width stays at 100% and the ratio is violated — a 9:16 vertical rendered at
   * 0.93 instead of 0.56. The fix is to compute the width explicitly as the
   * smaller of "full container width" and "container height x ratio", then let
   * aspect-ratio derive the height.
   */
  .lightbox-stage {
    position: relative;
    --ar-safe: var(--ar, 1.7778);
    aspect-ratio: var(--ar-safe);
    width: min(100cqw, calc(100cqh * var(--ar-safe)));
    background: #000;
    border-radius: var(--radius);
    overflow: hidden;
  }

  /* Older engines without size container queries: fill the width and accept
     that very tall videos may need scrolling. Correct ratio either way. */
  @supports not (width: 1cqh) {
    .lightbox-stage {
      width: 100%;
      max-width: 100%;
    }
  }

  .lightbox-stage :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
