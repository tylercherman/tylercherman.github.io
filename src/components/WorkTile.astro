---
/**
 * A tile in the work grid.
 *
 * Uniform 16:9 thumbnails; the lightbox plays each piece at its true aspect ratio,
 * so the crop is presentation only. `data-ar` carries the real ratio through.
 *
 * Info is revealed on hover/focus rather than always shown — visuals lead, per
 * PLAN.md §6.1.
 *
 * The label is deliberately just TITLE + runtime on every tile. An earlier version
 * showed the client name when one existed and fell back to the category when it
 * didn't, which meant brand work read "ADIDAS" while indie films read "TRAILER" —
 * inconsistent in kind, not just content. Client now appears in the lightbox title
 * bar, where it's shown the same way for everything.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  priority?: boolean;
}

const { entry, priority = false } = Astro.props;
const d = entry.data;

/** True ratio, for the lightbox — not for the thumbnail. */
const ar = (d.width / d.height).toFixed(6);

const minutes = d.duration ? Math.floor(d.duration / 60) : null;
const seconds = d.duration ? d.duration % 60 : null;
const runtime =
  minutes !== null && seconds !== null
    ? `${minutes}:${String(seconds).padStart(2, '0')}`
    : null;
---

<button
  class="tile"
  data-vimeo-id={d.vimeoId}
  data-vimeo-hash={d.vimeoHash ?? ''}
  data-title={d.client ? `${d.client} — ${d.title}` : d.title}
  data-ar={ar}
  type="button"
>
  <span class="tile-media">
    <Image
      src={d.poster}
      alt={d.alt ?? `${d.title}, edited by Tyler Cherman`}
      widths={[420, 700, 1000, 1400]}
      sizes="(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 33vw"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      class="tile-poster"
      style={`object-position: ${d.posterPosition};`}
    />

    <span class="tile-scrim" aria-hidden="true"></span>

    <span class="tile-play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M8 5.14v13.72L19 12 8 5.14Z" />
      </svg>
    </span>

    <span class="tile-info">
      <span class="tile-title">{d.title}</span>
      {runtime && <span class="tile-runtime">{runtime}</span>}
    </span>
  </span>

  {/* The full label, always available to screen readers regardless of hover. */}
  <span class="visually-hidden">
    Play {d.client ? `${d.client} — ` : ''}{d.title}{runtime ? `, ${runtime}` : ''}
  </span>
</button>

<style>
  .tile {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
    -webkit-tap-highlight-color: transparent;
  }

  .tile-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--c-bg-raised);
    border-radius: var(--radius);
  }

  .tile-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.88) saturate(0.94);
    transition: transform var(--dur-slow) var(--ease), filter var(--dur-base) var(--ease);
  }

  .tile:hover .tile-poster,
  .tile:focus-visible .tile-poster {
    filter: brightness(1) saturate(1);
    transform: scale(1.04);
  }

  /* Hidden at rest — the image is the whole tile until you interact with it. */
  .tile-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(6, 6, 7, 0.82) 0%,
      rgba(6, 6, 7, 0.30) 42%,
      transparent 72%
    );
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease);
  }

  .tile:hover .tile-scrim,
  .tile:focus-visible .tile-scrim { opacity: 1; }

  .tile-play {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--c-bg) 40%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--c-line-strong);
    color: var(--c-text);
    opacity: 0;
    scale: 0.88;
    transition: opacity var(--dur-base) var(--ease), scale var(--dur-base) var(--ease);
  }

  .tile-play svg { translate: 2px 0; }

  .tile:hover .tile-play,
  .tile:focus-visible .tile-play { opacity: 1; scale: 1; }

  /* ---------- Info: hover-revealed, identical structure on every tile ---------- */
  .tile-info {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-4);
    opacity: 0;
    translate: 0 8px;
    transition: opacity var(--dur-base) var(--ease), translate var(--dur-base) var(--ease);
  }

  .tile:hover .tile-info,
  .tile:focus-visible .tile-info { opacity: 1; translate: 0 0; }

  .tile-title {
    font-size: var(--t-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--c-text);
    line-height: var(--lh-snug);
  }

  .tile-runtime {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: var(--c-text-muted);
    font-variant-numeric: tabular-nums;
  }

  /*
   * Touch devices have no hover, so a hover-only label would be unreachable.
   * Reveal it there — but keep it quiet.
   */
  @media (hover: none) {
    .tile-scrim { opacity: 1; }
    .tile-info { opacity: 1; translate: 0 0; }
    .tile-play { opacity: 0.75; scale: 1; }
    .tile-poster { filter: none; }
  }
</style>
