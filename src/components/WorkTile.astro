---
/**
 * A tile in the work grid.
 *
 * All thumbnails are a uniform 16:9 regardless of the source video's shape — the
 * mixed ratios read as untidy in a grid. The lightbox then plays each piece at its
 * true aspect ratio, so nothing is actually lost: the crop is presentation only.
 *
 * `data-ar` carries the real ratio through to the lightbox for that reason.
 *
 * Metadata is always visible rather than hover-revealed: it works on touch, it
 * doesn't hide information behind an interaction, and it matches the reference.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  priority?: boolean;
}

const { entry, priority = false } = Astro.props;
const d = entry.data;

/** True ratio, for the lightbox — not for the thumbnail. */
const ar = (d.width / d.height).toFixed(6);

const minutes = d.duration ? Math.floor(d.duration / 60) : null;
const seconds = d.duration ? d.duration % 60 : null;
const runtime =
  minutes !== null && seconds !== null
    ? `${minutes}:${String(seconds).padStart(2, '0')}`
    : null;

const kindLabel = { trailer: 'Trailer', brand: 'Commercial', reel: 'Edit Reel' }[d.category];
---

<button
  class="tile"
  data-vimeo-id={d.vimeoId}
  data-vimeo-hash={d.vimeoHash ?? ''}
  data-title={d.client ? `${d.client} — ${d.title}` : d.title}
  data-ar={ar}
  type="button"
>
  <span class="tile-media">
    <Image
      src={d.poster}
      alt={d.alt ?? `${d.title}, edited by Tyler Cherman`}
      widths={[420, 700, 1000, 1400]}
      sizes="(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 33vw"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      class="tile-poster"
      style={`object-position: ${d.posterPosition};`}
    />

    <span class="tile-scrim" aria-hidden="true"></span>

    <span class="tile-play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
        <path d="M8 5.14v13.72L19 12 8 5.14Z" />
      </svg>
    </span>

    <span class="tile-info">
      <span class="tile-kind">{d.client ?? kindLabel}</span>
      <span class="tile-title">{d.title}</span>
      <span class="tile-meta">
        <span>{d.role}</span>
        {runtime && <><span aria-hidden="true">·</span><span class="tile-runtime">{runtime}</span></>}
      </span>
    </span>
  </span>

  <span class="visually-hidden">
    Play {d.client ? `${d.client} — ` : ''}{d.title}{runtime ? `, ${runtime}` : ''}
  </span>
</button>

<style>
  .tile {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
    -webkit-tap-highlight-color: transparent;
  }

  .tile-media {
    position: relative;
    display: block;
    /* Uniform across every piece — this is the change. */
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--c-bg-raised);
    border-radius: var(--radius);
    border: 1px solid var(--c-line);
    transition: border-color var(--dur-base) var(--ease);
  }

  .tile:hover .tile-media,
  .tile:focus-visible .tile-media { border-color: var(--c-line-strong); }

  .tile-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.82) saturate(0.92);
    transition: transform var(--dur-slow) var(--ease), filter var(--dur-base) var(--ease);
  }

  .tile:hover .tile-poster,
  .tile:focus-visible .tile-poster {
    filter: brightness(1) saturate(1);
    transform: scale(1.04);
  }

  /* Always present — the info sits on it permanently, so it can't be hover-only. */
  .tile-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(6, 6, 7, 0.88) 0%,
      rgba(6, 6, 7, 0.45) 34%,
      rgba(6, 6, 7, 0.05) 68%
    );
  }

  .tile-play {
    position: absolute;
    top: var(--s-3);
    right: var(--s-3);
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--c-bg) 45%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--c-line-strong);
    color: var(--c-text);
    opacity: 0;
    scale: 0.92;
    transition: opacity var(--dur-base) var(--ease), scale var(--dur-base) var(--ease);
  }

  .tile-play svg { translate: 1px 0; }

  .tile:hover .tile-play,
  .tile:focus-visible .tile-play { opacity: 1; scale: 1; }

  /* ---------- Info block: always visible ---------- */
  .tile-info {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: grid;
    gap: 2px;
    padding: var(--s-4);
  }

  .tile-kind {
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--c-text-muted);
  }

  .tile-title {
    font-size: var(--t-base);
    color: var(--c-text);
    line-height: var(--lh-snug);
  }

  .tile-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    font-size: var(--t-xs);
    color: var(--c-text-faint);
    margin-top: 1px;
  }

  .tile-runtime { font-variant-numeric: tabular-nums; }

  @media (hover: none) {
    .tile-play { opacity: 0.8; scale: 1; }
    .tile-poster { filter: brightness(0.9); }
  }
</style>
