---
/**
 * Full-viewport hero, centred composition.
 *
 * Name and role line sit in the middle of the frame with the video playing behind.
 *
 * Shows an autoplaying muted loop when `hero.video` is set in site.json, and the
 * placeholder still otherwise — so the layout is real before the video exists, and
 * dropping the file in is a one-line config change.
 *
 * The video is self-hosted rather than streamed from Vimeo on purpose. Vimeo's
 * direct-file URLs (`progressive_redirect/...`) return 403 without a signed,
 * expiring token, and embedding the player iframe instead would pull the whole
 * player bundle — which is the problem this rebuild exists to remove.
 *
 * Autoplay requires `muted` AND `playsinline`; without both, mobile Safari
 * refuses to start and iOS opens fullscreen.
 */
import { Image } from 'astro:assets';
import site from '../data/site.json';

/*
 * Shown wherever the video can't or shouldn't play: prefers-reduced-motion, and
 * Save-Data. Also stands in for the whole hero if `hero.video` is ever set to null.
 * The black-and-white portrait, at Tyler's request.
 */
import placeholder from '../assets/hero-fallback.jpg';

const hero = site.hero;
const hasVideo = Boolean(hero.video);
---

<section class="hero" aria-label="Introduction">
  <div class="hero-media">
    {hasVideo ? (
      <>
        <video
          class="hero-video"
          src={hero.video}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
          tabindex="-1"
        ></video>

        {/* Shown when the video is suppressed: reduced motion, or narrow screens
            where autoplaying megabytes over cellular is hostile. */}
        <Image
          src={placeholder}
          alt=""
          widths={[900, 1400, 2000, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="hero-fallback"
        />
      </>
    ) : (
      <Image
        src={placeholder}
        alt=""
        widths={[900, 1400, 2000, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="hero-still"
      />
    )}

    <div class="hero-scrim" aria-hidden="true"></div>
  </div>

  <div class="hero-content">
    {/*
      The headline's fill is a radial gradient clipped to the letterforms, centred
      on the pointer. Moving the cursor across the name brightens the letters it
      passes over — the type reacts to you, and because it's a gradient rather than
      a filter it stays perfectly legible at every position.
    */}
    <h1 class="hero-headline" id="hero-headline">{hero.headline}</h1>

    <p class="hero-roles">
      {hero.roles.map((role, i) => (
        <>
          {/* Rendered as a real element rather than a "|" character so screen
              readers don't read the divider aloud. */}
          {i > 0 && <span class="hero-divider" aria-hidden="true"></span>}
          <span>{role}</span>
        </>
      ))}
    </p>
  </div>

  <a class="hero-more" href="#work" aria-label="Jump to selected work">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path d="M12 5v14m0 0l-6-6m6 6l6-6" />
    </svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: var(--s-8) var(--gutter);
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-video,
  .hero-still,
  .hero-fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  /*
   * The portrait is 0.74 and the hero is wide, so a centre crop keeps only ~42% of
   * its height — a horizontal band. Anchoring at 30% puts that band on the face,
   * brow to chin, with the cap brim still in frame. Chosen by rendering five anchor
   * points and comparing, not by guessing.
   */
  .hero-still,
  .hero-fallback {
    object-position: center 30%;
  }

  .hero-fallback { display: none; }

  /*
   * Centred text over footage needs more protection than a bottom-anchored layout:
   * a radial darkening behind the middle keeps the name legible whatever frame the
   * video is on, plus a slight overall dim and a fade into the page below.
   */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 45% at 50% 48%, rgba(6, 6, 7, 0.62) 0%, rgba(6, 6, 7, 0.18) 60%, transparent 100%),
      linear-gradient(to bottom, rgba(6, 6, 7, 0.45) 0%, transparent 22%),
      linear-gradient(to top, var(--c-bg) 0%, rgba(10, 10, 11, 0.35) 14%, transparent 34%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 11vw, 9rem);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    line-height: 0.9;
    text-transform: uppercase;
    text-wrap: balance;

    /* Entrance: a slow settle of tracking and opacity on load. Subtle enough to
       register as polish rather than as an animation. */
    animation: hero-settle 1400ms cubic-bezier(0.16, 0.84, 0.32, 1) both;
  }

  /*
   * Cursor-tracked fill.
   *
   * --mx/--my are set by the script in percentages of the headline box. The bright
   * centre of the gradient follows the pointer; the rest of the letters sit at a
   * slightly softer white. Defaults to 50%/50% so with no pointer — touch devices,
   * no JS — the name reads as an evenly lit solid.
   *
   * The @supports test deliberately checks the GRADIENT as well as background-clip.
   * `color: transparent` is only safe while a background actually paints the
   * letters; if the gradient were dropped for any reason and this rule still
   * applied, the name would be invisible. That happened during development: an
   * earlier version used `circle 34%`, and a circle's radius cannot be a
   * percentage, so the whole declaration was discarded and the headline vanished.
   * An ellipse accepts percentage radii — hence this form.
   */
  @supports (background-clip: text) and
            (background-image: radial-gradient(ellipse 30% 180% at 50% 50%, #fff, #aaa)) {
    .hero-headline {
      --mx: 50%;
      --my: 50%;
      background-image: radial-gradient(
        ellipse 26% 175% at var(--mx) var(--my),
        /*
          The cursor darkens the letters to black rather than brightening them, so
          the name reads as being wiped away under the pointer and restored behind it.
          Everything outside the pointer stays solid white.

          The middle stops matter more than the ends: without them the black would
          land as a hard blob. Stepping through greys makes it a gradient falloff.
        */
        #000000 0%,
        #14141a 18%,
        #6d6d75 38%,
        color-mix(in srgb, var(--c-text) 92%, transparent) 62%,
        var(--c-text) 100%
      );
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }

  @keyframes hero-settle {
    from {
      opacity: 0;
      letter-spacing: 0.02em;
      translate: 0 10px;
    }
    to {
      opacity: 1;
      letter-spacing: var(--tracking-display);
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-headline { animation: none; }
  }

  .hero-roles {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(var(--s-3), 1.6vw, var(--s-5));
    margin-top: clamp(var(--s-4), 1.2vw, var(--s-5));
    /* Scales with the headline rather than sitting at a fixed 13px, which read as
       an afterthought next to a 144px name on a large display. */
    font-size: clamp(0.8125rem, 0.9vw, 1.0625rem);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--c-text);
  }

  /* The vertical bar between roles. --c-line-strong was too faint to read over
     footage; this needs to be visible against a bright frame as well as a dark one. */
  .hero-divider {
    width: 1px;
    height: 1.1em;
    background: color-mix(in srgb, var(--c-text) 55%, transparent);
  }

  /* ---------- Scroll cue ---------- */
  .hero-more {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: var(--s-6);
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--c-text-muted);
    transition: color var(--dur-fast) var(--ease), translate var(--dur-base) var(--ease);
  }

  .hero-more:hover {
    color: var(--c-text);
    translate: -50% 4px;
  }

  /*
   * The video plays on phones too. It was previously suppressed below 40rem to avoid
   * pushing megabytes over cellular, but Tyler cut the montage title-safe so it holds
   * up in a vertical crop, and wants it seen there.
   *
   * Still suppressed for `prefers-reduced-motion` — that's an accessibility setting,
   * not a bandwidth one, and some people get motion sickness from autoplaying video.
   * Save-Data is still honoured in the script below, so a visitor who has explicitly
   * asked their browser to conserve data gets the still instead.
   */
  @media (prefers-reduced-motion: reduce) {
    .hero-video { display: none; }
    .hero-fallback { display: block; }
  }
</style>

<script>
  // Save-Data is a request from the visitor not to burn their bandwidth. Honour it
  // by dropping the video and revealing the still.
  const nav = navigator as Navigator & { connection?: { saveData?: boolean } };
  if (nav.connection?.saveData) {
    document.querySelectorAll<HTMLVideoElement>('.hero-video').forEach((v) => {
      v.pause();
      v.removeAttribute('src');
      v.style.display = 'none';
    });
    document.querySelectorAll<HTMLElement>('.hero-fallback').forEach((el) => {
      el.style.display = 'block';
    });
  }

  /*
   * Point the headline's gradient at the cursor.
   *
   * Tracked across the whole hero rather than just the text, so the highlight is
   * already in the right place when the pointer arrives at the name instead of
   * snapping to it.
   *
   * Coordinates are written in a rAF callback: pointermove can fire many times per
   * frame, and setting a custom property each time would do redundant style work.
   * `(pointer: fine)` skips all of this on touch, where there is no cursor to
   * follow and the static centred gradient is what shows.
   */
  const heroEl = document.querySelector<HTMLElement>('.hero');
  const headline = document.getElementById('hero-headline');

  if (
    heroEl &&
    headline &&
    matchMedia('(pointer: fine)').matches &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    let pending = false;
    let px = 0;
    let py = 0;

    const paint = () => {
      pending = false;
      const r = headline.getBoundingClientRect();
      if (!r.width || !r.height) return;
      // Express the pointer as a percentage of the headline's own box, which is
      // what the radial-gradient position expects.
      const x = ((px - r.left) / r.width) * 100;
      const y = ((py - r.top) / r.height) * 100;
      headline.style.setProperty('--mx', `${x.toFixed(2)}%`);
      headline.style.setProperty('--my', `${y.toFixed(2)}%`);
    };

    heroEl.addEventListener(
      'pointermove',
      (event) => {
        px = event.clientX;
        py = event.clientY;
        if (!pending) {
          pending = true;
          requestAnimationFrame(paint);
        }
      },
      { passive: true }
    );

    // Return to an even fill when the pointer leaves, so the name doesn't keep a
    // stale hotspot from wherever the cursor exited.
    heroEl.addEventListener('pointerleave', () => {
      headline.style.setProperty('--mx', '50%');
      headline.style.setProperty('--my', '50%');
    });
  }
</script>
